// SourcingLocal — Prisma Schema
// Dev: SQLite (dev.db) → Prod: Supabase (PostgreSQL)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "sqlite"
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  avatar    String?  // URL Cloudinary ou null (initiales par défaut)
  role      String   @default("BUYER") // "BUYER" | "SELLER" | "ADMIN"

  // Notifications
  notifNewMessage  Boolean @default(true)  // Nouveau message reçu
  notifNewContact  Boolean @default(true)  // Nouvel acheteur contacte (seller)
  notifNewsletter  Boolean @default(false) // Newsletters SourcingLocal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop             Shop?
  reviews          Review[]
  subscription     Subscription?
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  @@index([email])
}

// ─────────────────────────────────────────────
// SHOP
// ─────────────────────────────────────────────
model Shop {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?
  banner      String?
  city        String?
  country     String   @default("Sénégal")
  address     String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId  String    @unique
  products Product[]

  @@index([slug])
}

// ─────────────────────────────────────────────
// CATEGORY
// ─────────────────────────────────────────────
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())

  // Relation many-to-many avec Product via table de jointure
  products ProductCategory[]

  @@index([slug])
}

// ─────────────────────────────────────────────
// PRODUCT — CATEGORY join table (max 3 catégories par produit)
// ─────────────────────────────────────────────
model ProductCategory {
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  @@id([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

// ─────────────────────────────────────────────
// PRODUCT
// ─────────────────────────────────────────────
model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  priceCfa    Int                     // Prix en francs CFA
  images      String                  // JSON array — max 2 URLs Cloudinary
  origin      String?                 // Origine géographique
  inStock     Boolean  @default(true) // true = En stock, false = En rupture
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  viewCount   Int      @default(0)    // Nombre de vues (à venir)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  categories ProductCategory[]
  shop       Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId     String
  reviews    Review[]

  @@index([shopId])
  @@index([inStock])
  @@index([isFeatured])
  @@index([slug])
}

// ─────────────────────────────────────────────
// REVIEW
// ─────────────────────────────────────────────
model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@unique([authorId, productId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// SUBSCRIPTION
// ─────────────────────────────────────────────
model Subscription {
  id                 String   @id @default(cuid())
  status             String   @default("INACTIVE")
  planName           String   @default("STARTER")
  priceCfa           Int
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  geniuspayRef       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────────
// MESSAGE
// ─────────────────────────────────────────────
model Message {
  id        String   @id @default(cuid())
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  sender     User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderId   String
  receiver   User   @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId String

  @@index([senderId])
  @@index([receiverId])
}
